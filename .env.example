NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://image_service:image_service@localhost:5432/image_service
POSTGRES_DB=image_service
POSTGRES_USER=image_service
POSTGRES_PASSWORD=image_service

JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_ISSUER=image-processing-service
JWT_AUDIENCE=image-processing-client
JWT_EXPIRES_IN=15m

STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
MAX_IMAGE_PIXELS=40000000
DRIZZLE_MIGRATIONS_DIR=./drizzle
